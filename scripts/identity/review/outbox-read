#!/bin/sh
# Read one file of a review session's outbox for the host, refusing anything that could spoof
# the host terminal or log (#634, C14). The host runs this in a throwaway container with the
# outbox volume mounted read-only, and only after the session container has exited: which file
# is opened rests on that precondition, since a live writer could swap the path between the
# check and the open.
#
#   outbox-read outcome    prints /review-out/outcome        (cap 512 bytes)
#   outbox-read body       prints /review-out/review.md      (cap 65536 bytes)
#   outbox-read findings   prints /review-out/findings.json  (cap 32768 bytes)
#
# Exit 0: printed. Exit 3: the file is absent (nothing printed). Exit 2: bad usage. Exit 1: a
# refusal -- nothing on stdout, one fixed reason word on stderr: symlink, not-regular, too-big,
# nul, bad-outcome or control.
#
# One read: after the regular-file, not-a-symlink check the file is copied once, at most cap+1
# bytes, with `timeout 10 head -c`, into a mktemp file; every later check runs on that copy and
# only the copy is printed, so the bytes printed are the bytes checked.
#
# outcome must be exactly one newline-terminated line of printable ASCII (0x20 to 0x7e). body and
# findings refuse any C0 control byte except tab and newline (0x01 to 0x08, 0x0b to 0x1f), 0x7f,
# and the UTF-8 encodings of C1 controls (0xc2 0x80 to 0xc2 0x9f); that refuses escape sequences
# and carriage returns. Two things still pass: bidirectional-override characters such as U+202E,
# and lone bytes 0x80 to 0x9f outside a valid UTF-8 sequence, which a terminal not in UTF-8 mode
# could read as C1 controls.
set -eu

# Fixed, not read from the environment; tests/review-image.test.sh runs a sed-substituted copy.
outbox='/review-out'

die() { printf '%s\n' "$1" >&2; exit 1; }

usage() { echo "usage: outbox-read outcome|body|findings" >&2; exit 2; }

[ "$#" -eq 1 ] || usage
case $1 in
  outcome)  f=$outbox/outcome;        cap=512 ;;
  body)     f=$outbox/review.md;      cap=65536 ;;
  findings) f=$outbox/findings.json;  cap=32768 ;;
  *) usage ;;
esac
kind=$1

if [ -L "$f" ]; then die symlink; fi
[ -e "$f" ] || exit 3
[ -f "$f" ] || die not-regular

tmp=$(mktemp) || die not-regular
trap 'rm -f "$tmp"' EXIT
timeout 10 head -c $((cap + 1)) <"$f" >"$tmp" 2>/dev/null || die not-regular

size=$(wc -c <"$tmp" | tr -d ' ')
[ "$size" -le "$cap" ] || die too-big

# Byte checks run in the C locale, on the copy. `tr -d` deletes the allowed bytes; any byte
# left is a refusal.
[ "$(LC_ALL=C tr -d '\001-\377' <"$tmp" | wc -c | tr -d ' ')" -eq 0 ] || die nul

if [ "$kind" = outcome ]; then
  # Exactly one line: one newline, and it is the last byte; every byte printable ASCII.
  [ "$size" -ge 1 ] || die bad-outcome
  [ "$(LC_ALL=C tr -cd '\n' <"$tmp" | wc -c | tr -d ' ')" -eq 1 ] || die bad-outcome
  [ "$(LC_ALL=C tail -c 1 "$tmp" | od -An -tx1 | tr -d ' ')" = 0a ] || die bad-outcome
  [ "$(LC_ALL=C tr -d '\040-\176\n' <"$tmp" | wc -c | tr -d ' ')" -eq 0 ] || die bad-outcome
else
  [ "$(LC_ALL=C tr -d '\011\012\040-\176\200-\377' <"$tmp" | wc -c | tr -d ' ')" -eq 0 ] || die control
  # C1 controls as UTF-8: 0xc2 followed by 0x80 to 0x9f.
  if LC_ALL=C od -An -v -tx1 "$tmp" | tr -d '\n' | LC_ALL=C grep -Eq ' c2 (8[0-9a-f]|9[0-9a-f])'; then
    die control
  fi
fi

cat "$tmp"
